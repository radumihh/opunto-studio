# Copiază în .env și completează. Variabilele setate direct în mediu au prioritate.

# Portul și adresa. Pe VM, în spatele nginx: HOST=127.0.0.1. Fără nginx: HOST=0.0.0.0.
PORT=4100
HOST=127.0.0.1

# Parola de intrare în Studio. Obligatorie dacă HOST nu e 127.0.0.1.
# După ce o schimbi din Setări, parola din Studio o înlocuiește pe aceasta.
ADMIN_PASSWORD=

# 1 când Studio stă în spatele nginx/caddy cu HTTPS: cookie-urile devin Secure,
# iar IP-ul real vine din X-Forwarded-For (pentru limitarea încercărilor de parolă).
TRUST_PROXY=0

# Unde stau datele și pozele. Implicit, lângă server.js.
# DATA_DIR=/var/lib/opunto-studio/data
# UPLOADS_DIR=/var/lib/opunto-studio/uploads

# Site-urile care pot citi /api/public din browser, separate prin virgulă. * = oricine.
PUBLIC_ORIGINS=*
