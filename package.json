{
  "name": "opunto-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Admin for the Opunto sites (#arch and #concepts): projects, images, live preview.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,app -c blue,magenta \"node --watch-path=server.js --watch-path=lib --watch-path=schema server.js\" \"vite\"",
    "build": "vite build",
    "start": "node server.js",
    "test": "node --test test/api.test.js",
    "setup": "npm ci && npm run build",
    "app": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^4.22.3",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.21"
  },
  "author": "Opunto",
  "build": {
    "appId": "ro.opunto.studio",
    "productName": "Opunto Studio",
    "copyright": "Opunto",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "package.json",
      "server.js",
      "lib/**",
      "schema/**",
      "preview/**",
      "dist/**",
      "electron/**",
      "data/db.json",
      "poze/**",
      "!poze/_incoming/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Opunto-Studio-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Opunto Studio",
      "deleteAppDataOnUninstall": false
    }
  }
}
